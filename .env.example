# Copie este arquivo para .env e ajuste os valores conforme necessário.
# A maioria das configurações do painel fica em Configurações (na própria
# interface web) — este .env cobre só o que precisa existir ANTES de o
# servidor subir.

# Texto exibido sob "Painel de Comunicações" na sidebar — identifica a
# unidade que está operando esta instância.
# Ex.: "DPU Curitiba", "Núcleo X". Default: "Defensoria Pública da União".
UNIDADE_DESCRICAO=

# Credenciais do SISDPU — modo LEGADO (fallback). O modo recomendado é
# cadastrar as credenciais pelo COFRE cifrado por senha-mestra, direto na
# interface do painel (primeiro acesso a uma função do SISDPU). Preencha
# aqui só se quiser manter as credenciais em texto plano no .env.
SISDPU_USERNAME=
SISDPU_PASSWORD=

# Se "1", o navegador da expedição de carta pelos Correios roda OCULTO
# (headless). Default "0" (visível) — permite acompanhar/concluir o
# assistente do site quando algo exigir atenção manual.
CORREIOS_HEADLESS=0

# Análise por IA (Claude Code CLI) das tramitações — resumo/classificação/
# sugestão de mensagem. Requer o `claude` instalado e autenticado na máquina
# (ver o manual, seção "Ligar o Modo com IA"); sem ele, o painel roda em
# Modo Simples automaticamente. O toggle Modo com IA/Simples fica em
# Configurações — estas variáveis são só para ajuste fino, normalmente
# desnecessário.
# ANALISE_ATIVA=1
# ANALISE_MODELO=sonnet
# ANALISE_TIMEOUT_SEG=180
